# =============================================================================
# Theme & Appearance
# =============================================================================
# Matched to starship.toml's Gruvbox Dark palette (change to 'Ayu Mirage' if preferred)
theme = gruvbox-dark

# Background transparency (0.9 = 90% opaque / 10% transparent)
background-opacity = 0.9

# Frosted glass blur effect behind the window (macOS and supported Linux compositors)
background-blur-radius = 20

# =============================================================================
# Fonts & Typography
# =============================================================================
font-family = "JetBrains Mono"
font-size = 14

# =============================================================================
# Window Configuration
# =============================================================================
# Adds breathing room around Starship's Powerline capsules ( ... )
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true

# =============================================================================
# Cursor & Mouse
# =============================================================================
cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true

# =============================================================================
# macOS Specific Behavior
# =============================================================================
# Uses Left Option as Alt for word jumping, preserving Right Option for symbols/diacritics.
# (Ignored on Linux)
macos-option-as-alt = left

# =============================================================================
# Shell Integration
# =============================================================================
# Enables shell integration and OSC 133 prompt tracking with Starship
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo
