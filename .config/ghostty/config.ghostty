# =============================================================================
# Theme & Appearance
# =============================================================================
# Matched to starship.toml's Gruvbox Dark palette (change to 'Ayu Mirage' if preferred)
theme = "Gruvbox Dark"

# Background transparency (0.75 = 75% opaque / 25% transparent for richer frosted glass)
background-opacity = 0.75

# Frosted glass blur effect behind the window (KDE Plasma Wayland and macOS)
background-blur = true

# Force dark window chrome / client decoration theme variant
window-theme = dark

# =============================================================================
# Fonts & Typography
# =============================================================================
font-family = "JetBrainsMono Nerd Font"
font-size = 14

# OpenType Font Features:
#   calt, liga : Standard programming ligatures (e.g. !=, ===, =>, ->)
#   dlig       : Discretionary ligatures
#   zero       : Slashed zero to distinctly differentiate '0' from 'O'
font-feature = calt
font-feature = liga
font-feature = dlig
font-feature = zero

# =============================================================================
# Window Configuration
# =============================================================================
# Initial default window dimensions (columns x rows)
window-width = 120
window-height = 40

# Window decoration style:
# Default to 'auto' so macOS AppKit properly renders native tabs and titlebar chrome.
# On Linux Wayland (KWin), setup.sh links config.local which sets 'window-decoration = client'
# to keep the integrated tabs titlebar and resize handles under KWin.
window-decoration = auto

# Inner breathing room around Starship's Powerline capsules ( ... )
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-padding-color = background

# Linux / GTK titlebar and tab integration:
# 'tabs' merges the tab bar into the titlebar to maximize vertical screen area
gtk-titlebar-style = tabs
gtk-wide-tabs = true

# Dim inactive split panes for immediate visual focus
unfocused-split-opacity = 0.70

# =============================================================================
# Cursor & Mouse
# =============================================================================
cursor-style = bar
cursor-style-blink = true
cursor-click-to-move = true
mouse-hide-while-typing = true

# =============================================================================
# macOS Specific Behavior
# =============================================================================
# Uses Left Option as Alt for word jumping, preserving Right Option for symbols/diacritics.
# (Ignored on Linux)
macos-option-as-alt = left

# macOS Titlebar Style:
# 'transparent' provides a seamless frosted glass blur across the window while
# rendering full-width native tabs. 'tabs' triggers a known upstream AppKit bug
# where the tab container collapses into a ~15% width box on the right side.
macos-titlebar-style = transparent

# =============================================================================
# Shell Integration
# =============================================================================
# Enables shell integration and OSC 133 prompt tracking with Starship
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# =============================================================================
# Local & Platform Overrides
# =============================================================================
# Loads ~/.config/ghostty/config.local if present (symlinked by setup.sh for OS-specific tuning)
config-file = "?~/.config/ghostty/config.local"
