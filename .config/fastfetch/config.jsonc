{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  󰅂  ",
    "color": {
      "separator": "yellow"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "yellow",
        "at": "red",
        "host": "yellow"
      }
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": " os  ",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": " ker ",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key": "󰅐 up  ",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": " term",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": " sh  ",
      "keyColor": "blue"
    },
    {
      "type": "cpu",
      "key": "󰍛 cpu ",
      "keyColor": "magenta",
      "format": "{name} ({cores-physical}) @ {freq-max}"
    },
    {
      "type": "gpu",
      "key": "󰢮 gpu ",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": " mem ",
      "keyColor": "yellow"
    },
    {
      "type": "disk",
      "key": "󰋊 disk",
      "keyColor": "green",
      "folders": "/"
    },
    {
      "type": "break"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
